.env
__pycache__/
.venv/
.ruff_cache/
.pytest_cache/
.coverage
.terraform/
*.tfplan
*.tfstate*
crash.log

# Emergency barriers written by `hal stop` (dynamic/.gitkeep stays tracked)
/dynamic/switch-*

# The legal pages `hal apply` builds (legal/built/.gitkeep stays tracked)
/legal/built/*
!/legal/built/.gitkeep

# What `hal apply` last wrote there, beside the pages nginx serves

# What the apply's appkit step writes: the installed appkit's files, served beside legal.css and
# from each Keycloak theme's resources
/legal/assets/appkit-*/
/keycloak/themes/hallucinai/login/resources/appkit-*/
/keycloak/themes/hallucinai/account/resources/appkit-*/
