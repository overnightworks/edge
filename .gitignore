.env
__pycache__/
.venv/
.ruff_cache/
.pytest_cache/
.coverage
.terraform/
*.tfplan
*.tfstate*
crash.log

# Emergency barriers written by `edge stop` (dynamic/.gitkeep stays tracked)
/dynamic/switch-*

# The legal pages `edge apply` builds (legal/built/.gitkeep stays tracked)
/legal/built/*
!/legal/built/.gitkeep

# What `edge apply` last wrote there, beside the pages nginx serves

# What the apply's appkit step serves beside legal.css (the installed appkit's files)
/legal/assets/appkit-*/
