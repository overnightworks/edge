# Copy to .env next to compose.yaml. Neither value is a secret; never commit .env anyway.

# Base domain: a container labelled edge.name=<name> is routed as <name>.<EDGE_DOMAIN>.
EDGE_DOMAIN=hallucinai.de

# Numeric gid of the host's docker group, so the socket proxy may open /var/run/docker.sock.
# Fill it from: getent group docker | cut -d: -f3   (127 on the operator's PC)
DOCKER_GID=
