#!/usr/bin/env python3
"""agent-service/setup: the agent service's image, login folders and login token.

Runs in the operator's terminal (`hal apply` asks first). Every step checks its own done-state
first: a second run changes nothing. The token is read without echo and exists only in
~/.secrets/agent-service/claude/token; it is never printed and never on a command line.

    agent-service/setup           fix what is missing: build the image, make the folders (0700),
                                  narrow a too-open token file, take a pasted token when it is
                                  missing or refused
    agent-service/setup --renew   the same, and always take a new token: written beside the old
                                  one as token.new and renamed over it
    agent-service/setup --check   change nothing: exit 0 set up, 1 not set up (one line says what),
                                  2 cannot tell. It is the setup contract `edge apply` asks.
    agent-service/setup --replace-signing-key
                                  a new signing key pair over the old one: terminal and typed yes

The signing key pair in ~/.secrets/agent-service/signing is made once; a plain run and --renew
refuse a pair they cannot use and leave it as it is. Key bytes travel only over pipes to openssl.

The token rules equal the service's reader (agent_runtime/secret_file.py, agent-runtime
v0.7.0): a regular file of at most 16 KiB that group and others cannot touch, holding one
printable line without whitespace that is neither JSON nor an API key. A pasted line is judged as
the exact bytes to be written, with those rules, before anything is created; a refused paste
leaves the old token as it was. Every write goes through a descriptor of ~/.secrets/agent-service/
claude, reached without following a link, and holds a lock on it, so a link cannot send the paste
elsewhere and two runs cannot swap in each other's file.
"""

from __future__ import annotations

import argparse
import contextlib
import errno
import fcntl
import getpass
import json
import os
import re
import stat
import subprocess
import sys
import warnings
from collections.abc import Callable, Iterator
from dataclasses import dataclass
from enum import Enum, IntEnum
from pathlib import Path

REPO = Path(__file__).resolve().parents[1]
SERVICE = "agent-service"
SERVICE_UID = 1000  # compose.yaml runs the service as 1000:1000, so it must own the login files
DIRECTORY_MODE = 0o700
TOKEN_MODE = 0o600
TOKEN_FILE = "token"
PENDING_FILE = "token.new"
MAX_TOKEN_FILE_BYTES = 16 * 1024  # reader: MAX_SECRET_FILE_BYTES
API_KEY_PREFIX = "sk-ant-api"  # reader: API_KEY_PREFIX
JSON_WHITESPACE = " \t\r\n"  # reader: _JSON_WHITESPACE
SIGNING_DIRECTORY = "signing"
PRIVATE_FILE, PUBLIC_FILE = "private.pem", "public.pem"
PRIVATE_CANDIDATE, PUBLIC_CANDIDATE = "private.pem.new", "public.pem.new"
PRIVATE_NEXT, PUBLIC_NEXT = "private.next.pem", "public.next.pem"
PRIVATE_KEY_MODE, PUBLIC_KEY_MODE = 0o600, 0o644
LEFTOVERS = (PRIVATE_CANDIDATE, PUBLIC_CANDIDATE, PRIVATE_NEXT, PUBLIC_NEXT)
RSA_BITS, OPENSSL_SECONDS = 3072, 120
PRIVATE_KEY_BLOCK = re.compile(
    rb"\A-----BEGIN PRIVATE KEY-----\n[A-Za-z0-9+/=\n]+\n-----END PRIVATE KEY-----\n\Z"
)
PUBLIC_KEY_DETAILS = re.compile(
    rb"\APublic-Key: \(%d bit\)\n.*\nExponent: 65537 \(0x10001\)\n\Z" % RSA_BITS, re.DOTALL
)
DERIVE_PUBLIC_KEY = ["pkey", "-pubout"]
GENERATE_PRIVATE_KEY = [
    *("genpkey", "-algorithm", "RSA", "-pkeyopt", f"rsa_keygen_bits:{RSA_BITS}"),
    *("-pkeyopt", "rsa_keygen_pubexp:65537"),
]
REPLACE_COMMAND = (
    "`agent-service/setup --replace-signing-key` makes a new pair; "
    "then recreate agent-service and songmaker-web"
)
BUILD_SECONDS = 1800
MAX_DIAGNOSTIC_CHARACTERS = 200  # what one docker diagnostic line may add to a printed line
SHORT_COMMAND_SECONDS = 60
DOCKERFILE = "agent-service/image/Dockerfile"
BUILD_CONTEXT = "agent-service/image"
PROFILE = "agent-service"
COMPOSE = [
    "docker", "compose", "--project-directory", str(REPO), "--file", "compose.yaml",
    "--profile", PROFILE,
]  # fmt: skip


class Exit(IntEnum):
    DONE = 0
    REFUSED = 1
    CANNOT_TELL = 2


class GapKind(Enum):
    IMAGE_MISSING = "image"
    DIRECTORY_MISSING = "directory missing"
    DIRECTORY_OPEN = "directory mode"
    TOKEN_MISSING = "token missing"
    TOKEN_OPEN = "token mode"
    TOKEN_REFUSED = "token refused"
    UNFIXABLE = "needs the operator"


@dataclass(frozen=True)
class Gap:
    kind: GapKind
    line: str
    path: Path | None = None


class SigningState(Enum):
    SOUND = "sound"
    EMPTY = "no key yet"
    PUBLIC_REWRITE = "public half missing or with another mode"
    BROKEN = "needs --replace-signing-key"
    OPERATOR_FIX = "needs the operator, replaceable"
    FOREIGN = "needs the operator"


UNUSABLE = {SigningState.BROKEN, SigningState.OPERATOR_FIX, SigningState.FOREIGN}


@dataclass(frozen=True)
class Entry:  # a signing file as one descriptor saw it; `problem` is the operator's to fix
    path: Path
    status: os.stat_result | None = None
    contents: bytes = b""
    problem: str | None = None


class StepFailure(Exception):
    """A step cannot finish; the message says why in one line, never a secret."""


class CannotTell(StepFailure):
    """Docker or the host did not answer, so the state of a step is unknown."""


def run_command(command: list[str], timeout: int) -> subprocess.CompletedProcess[str]:
    try:
        return subprocess.run(
            command, capture_output=True, text=True, check=False, timeout=timeout, cwd=REPO
        )
    except subprocess.TimeoutExpired as error:
        raise CannotTell(f"`{' '.join(command[:3])}` took longer than {timeout}s") from error
    except OSError as error:
        raise CannotTell(f"cannot run {command[0]}: {error.strerror}") from error


def run_openssl(arguments: list[str], stdin: bytes) -> subprocess.CompletedProcess[bytes]:
    """Key bytes go in and out over pipes only; the caller never prints either stream."""
    try:
        return subprocess.run(
            ["openssl", *arguments], input=stdin, capture_output=True, check=False,
            timeout=OPENSSL_SECONDS,
        )  # fmt: skip
    except subprocess.TimeoutExpired as error:
        raise CannotTell(f"`openssl {arguments[0]}` took longer than {OPENSSL_SECONDS}s") from error
    except OSError as error:
        raise CannotTell(f"cannot run openssl: {error.strerror}") from error


def read_pasted_line(prompt: str) -> str:
    """One line from the terminal without echo; no way to hide it is a failure, never a fallback."""
    with warnings.catch_warnings():
        warnings.simplefilter("error", getpass.GetPassWarning)
        try:
            return getpass.getpass(prompt)
        except getpass.GetPassWarning as error:
            raise StepFailure("the terminal cannot hide the paste; nothing was read") from error
        except EOFError as error:
            raise StepFailure(
                "no token was pasted (the input ended); nothing was written"
            ) from error
        except UnicodeDecodeError:
            # `from None`: the error would carry the pasted bytes into any traceback chain
            raise StepFailure("the pasted line is not UTF-8 text; nothing was written") from None


@dataclass(frozen=True)
class Tools:
    """Everything outside the script's logic: Docker, the terminal, the service's uid."""

    run: Callable[[list[str], int], subprocess.CompletedProcess[str]] = run_command
    say: Callable[[str], None] = print
    read_secret: Callable[[str], str] = read_pasted_line
    service_uid: int = SERVICE_UID
    openssl: Callable[[list[str], bytes], subprocess.CompletedProcess[bytes]] = run_openssl
    has_terminal: Callable[[], bool] = lambda: sys.stdin.isatty() and sys.stdout.isatty()
    confirm: Callable[[str], str] = input


def refusal_of_token(text: str) -> str | None:
    """Why the reader refuses this token text, else None; the reader's checks in its order."""
    token = text.removesuffix("\n")
    if not token:
        return "is empty; it must hold the token"
    if "\n" in token:
        return "holds more than one line; it must hold one token"
    if not token.isprintable():
        return "contains a control or non-printing character; a token must not"
    if line_is_json(token):
        return "holds a JSON document; it must hold one setup token"
    if any(character.isspace() for character in token):
        return "holds whitespace; a setup token holds none"
    if token.startswith(API_KEY_PREFIX):
        return "holds an API key; it must hold a subscription token from setup-token"
    return None


def line_is_json(line: str) -> bool:
    if line.lstrip(JSON_WHITESPACE).startswith(("{", "[")):
        return True
    try:
        json.loads(line)
    except ValueError:
        return False
    return True


def read_within_limit(descriptor: int) -> bytes:
    """At most one byte more than the limit, looping on short reads as the reader does
    (secret_file.py:144-155, _read_within_limit): that many bytes mean the file is too big."""
    chunks: list[bytes] = []
    remaining = MAX_TOKEN_FILE_BYTES + 1
    while remaining and (chunk := os.read(descriptor, remaining)):
        chunks.append(chunk)
        remaining -= len(chunk)
    return b"".join(chunks)


def refusal_of_token_bytes(contents: bytes) -> str | None:
    """The reader's verdict on the file's exact bytes, for a file read and for a paste to write."""
    if len(contents) > MAX_TOKEN_FILE_BYTES:
        return f"is larger than {MAX_TOKEN_FILE_BYTES} bytes"
    try:
        return refusal_of_token(contents.decode("utf-8"))
    except UnicodeDecodeError:
        return "is not UTF-8 text"


def file_contents_of_paste(pasted: str) -> bytes:
    """The exact bytes a paste would become, or a refusal: nothing is created for a refused one."""
    try:
        contents = f"{pasted}\n".encode()
    except UnicodeEncodeError as error:
        raise StepFailure("the pasted line is not UTF-8 text; nothing was written") from error
    if refusal := refusal_of_token_bytes(contents):
        raise StepFailure(f"the pasted line {refusal}; nothing was written")
    return contents


class AgentServiceSetup:
    def __init__(self, tools: Tools, home: Path) -> None:
        self.tools = tools
        self.home = home
        self.secrets_root = home / ".secrets"
        self.service_directory = self.secrets_root / SERVICE
        self.login_directory = self.service_directory / "claude"
        self.token_path = self.login_directory / TOKEN_FILE
        self.login_chain = (self.secrets_root, self.service_directory, self.login_directory)
        self.signing_directory = self.service_directory / SIGNING_DIRECTORY
        self.signing_chain = (self.secrets_root, self.service_directory, self.signing_directory)
        self.signing = SigningKey(self)
        self.pasted = False

    # --- what is missing ----------------------------------------------------------------------

    def first_gap(self) -> Gap | None:
        """The first thing that is not as the service needs it, in the order a fix can follow."""
        return (
            self.image_gap()
            or self.directory_gap(self.secrets_root)
            or self.directory_gap(self.service_directory)
            or self.directory_gap(self.login_directory)
            or self.token_gap()
            or self.directory_gap(self.signing_directory)
        )

    def image_name(self) -> str:
        """The image has one owner: compose.yaml."""
        result = self.tools.run([*COMPOSE, "config", "--format", "json"], SHORT_COMMAND_SECONDS)
        if result.returncode != 0:
            raise CannotTell(failure_line("docker compose config", result))
        return json.loads(result.stdout)["services"][SERVICE]["image"]

    def image_gap(self) -> Gap | None:
        image = self.image_name()
        result = self.tools.run(["docker", "image", "inspect", image], SHORT_COMMAND_SECONDS)
        if result.returncode == 0:
            return None
        if "no such image" in (result.stderr + result.stdout).lower():
            return Gap(GapKind.IMAGE_MISSING, f"the image {image} is not built")
        raise CannotTell(failure_line("docker image inspect", result))

    def directory_gap(self, directory: Path) -> Gap | None:
        try:
            status = os.lstat(directory)
        except FileNotFoundError:
            return Gap(GapKind.DIRECTORY_MISSING, f"{directory} does not exist", directory)
        return self.judge_directory(directory, status)

    def judge_directory(self, directory: Path, status: os.stat_result) -> Gap | None:
        """A link is never followed: a symlinked folder could send the token out of ~/.secrets."""
        if stat.S_ISLNK(status.st_mode):
            return Gap(GapKind.UNFIXABLE, f"{directory} is a symbolic link; it must be a folder")
        if not stat.S_ISDIR(status.st_mode):
            return Gap(GapKind.UNFIXABLE, f"{directory} is not a directory")
        if status.st_uid != self.tools.service_uid:
            return self.wrong_owner(directory, status.st_uid)
        if (mode := stat.S_IMODE(status.st_mode)) != DIRECTORY_MODE:
            return Gap(
                GapKind.DIRECTORY_OPEN, f"{directory} has mode {mode:04o}, not 0700", directory
            )
        return None

    def wrong_owner(self, path: Path, uid: int) -> Gap:
        return Gap(
            GapKind.UNFIXABLE,
            f"{path} is owned by uid {uid}, not {self.tools.service_uid}, the service's user "
            '(docs/agent-service.md, "Why 1000:1000")',
        )

    def token_gap(self) -> Gap | None:
        """The token file judged through one descriptor, as the reader does; never its content.

        A link is never set up: compose.yaml binds only the login folder, so a link that resolves
        on the host may not resolve in the container."""
        path = self.token_path
        flags = os.O_RDONLY | os.O_NOFOLLOW | os.O_NONBLOCK | os.O_CLOEXEC
        try:
            descriptor = os.open(path, flags)
        except FileNotFoundError:
            return Gap(GapKind.TOKEN_MISSING, f"{path} does not exist")
        except PermissionError as error:
            return Gap(GapKind.TOKEN_REFUSED, f"{path} cannot be read: {error.strerror}")
        except OSError as error:
            if error.errno == errno.ELOOP:
                return Gap(
                    GapKind.TOKEN_REFUSED,
                    f"{path} is a symbolic link; it must be a regular file",
                )
            raise
        try:
            return self.judge_open_token(descriptor)
        finally:
            os.close(descriptor)

    def judge_open_token(self, descriptor: int) -> Gap | None:
        path = self.token_path
        status = os.fstat(descriptor)
        if not stat.S_ISREG(status.st_mode):
            return Gap(GapKind.TOKEN_REFUSED, f"{path} is not a regular file")
        if status.st_uid != self.tools.service_uid:
            return self.wrong_owner(path, status.st_uid)
        if status.st_mode & 0o077:
            mode = stat.S_IMODE(status.st_mode)
            return Gap(
                GapKind.TOKEN_OPEN, f"{path} is open to group or others (mode {mode:04o})", path
            )
        if status.st_size > MAX_TOKEN_FILE_BYTES:
            return Gap(GapKind.TOKEN_REFUSED, f"{path} is larger than {MAX_TOKEN_FILE_BYTES} bytes")
        contents = read_within_limit(descriptor)
        if reason := refusal_of_token_bytes(contents):
            return Gap(GapKind.TOKEN_REFUSED, f"{path} {reason}")
        return None

    # --- the fixes ----------------------------------------------------------------------------

    def fix(self, gap: Gap) -> None:
        match gap.kind:
            case GapKind.IMAGE_MISSING:
                self.build_image()
            case GapKind.DIRECTORY_MISSING:
                self.make_directory(gap.path)
            case GapKind.DIRECTORY_OPEN:
                self.narrow(gap.path, DIRECTORY_MODE)
            case GapKind.TOKEN_OPEN:
                self.narrow(gap.path, TOKEN_MODE)
            case GapKind.TOKEN_MISSING | GapKind.TOKEN_REFUSED:
                self.paste_token(gap.line)
            case GapKind.UNFIXABLE:
                raise StepFailure(gap.line)

    def build_image(self) -> None:
        image = self.image_name()
        self.tools.say(f"building {image} (the pinned downloads take a few minutes)")
        result = self.tools.run(
            ["docker", "build", "-f", DOCKERFILE, "-t", image, BUILD_CONTEXT], BUILD_SECONDS
        )
        if result.returncode != 0:
            raise CannotTell(failure_line("docker build", result))

    def make_directory(self, directory: Path) -> None:
        """The gap order makes every parent exist and be judged first, so one level is made."""
        self.tools.say(f"making {directory} with mode 0700")
        os.mkdir(directory, DIRECTORY_MODE)

    def narrow(self, path: Path, mode: int) -> None:
        """Change the mode through the verified chain of descriptors, as the swap does: what is
        changed is what the check looked at, and a folder swapped for a link in between is not."""
        self.tools.say(f"narrowing {path} to {mode:04o}")
        is_token = path == self.token_path
        chain = self.signing_chain if path == self.signing_directory else self.login_chain
        parents = chain if is_token else chain[: chain.index(path)]
        parent = self.open_verified_directories(parents)
        try:
            flags = os.O_RDONLY | os.O_NOFOLLOW | os.O_NONBLOCK | os.O_CLOEXEC
            try:
                descriptor = os.open(path.name, flags, dir_fd=parent)
            except OSError as error:
                if error.errno == errno.ELOOP:
                    raise StepFailure(f"{path} is a symbolic link; nothing was changed") from error
                raise
            try:
                if not self.still_narrowable(path, os.fstat(descriptor), is_token):
                    raise StepFailure(f"{path} changed since it was judged; nothing was changed")
                os.fchmod(descriptor, mode)
            finally:
                os.close(descriptor)
        finally:
            os.close(parent)

    def still_narrowable(self, path: Path, status: os.stat_result, is_token: bool) -> bool:
        if is_token:
            return stat.S_ISREG(status.st_mode) and status.st_uid == self.tools.service_uid
        gap = self.judge_directory(path, status)
        return gap is None or gap.kind is GapKind.DIRECTORY_OPEN

    def paste_token(self, reason: str | None = None) -> None:
        """Take the token, judge the bytes to write, and swap them in by rename."""
        if reason:
            self.tools.say(reason)
        self.tools.say(
            "run `claude setup-token` in another terminal and paste its token here; "
            "nothing is shown"
        )
        payload = file_contents_of_paste(self.tools.read_secret("token: ").strip())
        self.swap_in(payload)
        self.pasted = True

    def swap_in(self, payload: bytes) -> None:
        """Write token.new and rename it over token inside the verified, locked login folder."""
        directory = self.open_verified_directories(self.login_chain)
        try:
            self.lock(directory)  # held until the descriptor closes
            try:
                self.write_pending(directory, payload)
                os.replace(PENDING_FILE, TOKEN_FILE, src_dir_fd=directory, dst_dir_fd=directory)
            except OSError as error:
                with contextlib.suppress(OSError):  # the failure being reported is the first one
                    os.unlink(PENDING_FILE, dir_fd=directory)
                raise StepFailure(
                    f"cannot write the token ({error.filename or TOKEN_FILE}): {error.strerror};"
                    " the old token is kept"
                ) from error
            try:
                os.fsync(directory)
            except OSError as error:
                raise StepFailure(
                    f"the new token is in place, but the folder could not be synced: "
                    f"{error.strerror}"
                ) from error
        finally:
            os.close(directory)

    def lock(self, directory: int) -> None:
        try:
            fcntl.flock(directory, fcntl.LOCK_EX | fcntl.LOCK_NB)
        except BlockingIOError:
            self.tools.say("waiting for another run of agent-service/setup")
            fcntl.flock(directory, fcntl.LOCK_EX)

    @staticmethod
    def write_pending(
        directory: int, payload: bytes, name: str = PENDING_FILE, mode: int = TOKEN_MODE
    ) -> None:
        with contextlib.suppress(FileNotFoundError):
            os.unlink(name, dir_fd=directory)
        flags = os.O_WRONLY | os.O_CREAT | os.O_EXCL | os.O_NOFOLLOW | os.O_CLOEXEC
        descriptor = os.open(name, flags, mode, dir_fd=directory)
        with os.fdopen(descriptor, "wb") as pending_file:
            os.fchmod(descriptor, mode)
            pending_file.write(payload)
            pending_file.flush()
            os.fsync(descriptor)

    def open_verified_directories(self, directories: tuple[Path, ...]) -> int:
        """A descriptor of the last folder, each folder from home on opened without following a
        link and judged by its own descriptor: what is written lands where the check looked."""
        directory = os.open(self.home, os.O_RDONLY | os.O_DIRECTORY | os.O_CLOEXEC)
        try:
            for path in directories:
                child = self.open_without_link(directory, path)
                os.close(directory)
                directory = child
                if gap := self.judge_directory(path, os.fstat(directory)):
                    raise StepFailure(f"{gap.line}; nothing was written")
        except BaseException:
            os.close(directory)
            raise
        return directory

    @staticmethod
    def open_without_link(parent: int, path: Path) -> int:
        flags = os.O_RDONLY | os.O_DIRECTORY | os.O_NOFOLLOW | os.O_CLOEXEC
        try:
            return os.open(path.name, flags, dir_fd=parent)
        except OSError as error:
            if error.errno in (errno.ELOOP, errno.ENOTDIR):
                raise StepFailure(f"{path} is not a plain folder; nothing was written") from error
            raise

    # --- the commands -------------------------------------------------------------------------

    def run(self, renew: bool) -> int:
        def fix_everything() -> None:
            for _ in range(len(GapKind) + 1):
                if (gap := self.first_gap()) is not None:
                    self.fix(gap)
                elif renew and not self.pasted:
                    self.paste_token()
                else:
                    self.signing.ensure()
                    self.tools.say("agent-service/setup: set up")
                    return
            raise StepFailure("still not set up after the fixes")

        return self.attempt(fix_everything, read_only=False)

    def check(self) -> int:
        def judge() -> None:
            if (gap := self.first_gap()) is not None:
                raise StepFailure(gap.line)
            self.signing.check()
            self.tools.say("agent-service/setup --check: set up")

        return self.attempt(judge, read_only=True)

    def replace_signing_key(self) -> int:
        return self.attempt(self.signing.replace, read_only=False)

    def attempt(self, action: Callable[[], None], read_only: bool) -> int:
        """Run `action` as the one boundary: a failure is a line and an exit code, no traceback."""
        try:
            action()
        except CannotTell as failure:
            self.tools.say(f"agent-service/setup: cannot tell: {failure}")
            return Exit.CANNOT_TELL
        except StepFailure as failure:
            prefix = "--check: not set up" if read_only else "FAILED"
            self.tools.say(f"agent-service/setup {prefix}: {failure}")
            return Exit.REFUSED
        except OSError as error:
            # A host that cannot be read says nothing about the setup: only a check may say "2".
            where = f" ({error.filename})" if error.filename else ""
            if read_only:
                self.tools.say(f"agent-service/setup: cannot tell: {error.strerror}{where}")
                return Exit.CANNOT_TELL
            self.tools.say(f"agent-service/setup FAILED: {error.strerror}{where}")
            return Exit.REFUSED
        except KeyboardInterrupt:
            self.tools.say("agent-service/setup: interrupted")
            return Exit.REFUSED
        return Exit.DONE


class SigningKey:
    """The signing key pair, judged and written through the signing folder's verified descriptor."""

    def __init__(self, setup: AgentServiceSetup) -> None:
        self.setup = setup

    @contextlib.contextmanager
    def open_directory(self, locked: bool) -> Iterator[int]:
        directory = self.setup.open_verified_directories(self.setup.signing_chain)
        try:
            if locked:
                self.setup.lock(directory)
            yield directory
        finally:
            os.close(directory)

    def check(self) -> None:
        with self.open_directory(locked=False) as directory:
            state, line = self.judge(directory)
            leftovers = [name for name in LEFTOVERS if name in os.listdir(directory)]
        if state is not SigningState.SOUND:
            raise StepFailure(line)
        if leftovers:
            names = ", ".join(leftovers)
            raise StepFailure(f"{names} left by an interrupted run; `agent-service/setup` clears")

    def judge(self, directory: int) -> tuple[SigningState, str]:
        """The first thing wrong with the pair, in the order a fix can follow."""
        folder = self.setup.signing_directory
        private = self.read_entry(directory, PRIVATE_FILE)
        public = self.read_entry(directory, PUBLIC_FILE)
        for entry in (private, public):
            if entry and entry.problem:
                return SigningState.FOREIGN, f"{entry.path} {entry.problem}; fix it yourself"
        if private is None:
            if public is None:
                return SigningState.EMPTY, f"{folder / PRIVATE_FILE} does not exist"
            line = f"signing/{PRIVATE_FILE} is missing but {PUBLIC_FILE} is still there: "
            return SigningState.BROKEN, line + REPLACE_COMMAND
        mode = stat.S_IMODE(private.status.st_mode)
        if mode != PRIVATE_KEY_MODE:
            line = f"{private.path} has mode {mode:04o}, not 0600; fix it yourself"
            return SigningState.OPERATOR_FIX, line
        if reason := self.private_refusal(private.contents):
            return SigningState.BROKEN, f"{private.path} {reason}: {REPLACE_COMMAND}"
        candidate = (
            os.stat(PRIVATE_CANDIDATE, dir_fd=directory, follow_symlinks=False)
            if PRIVATE_CANDIDATE in os.listdir(directory)
            else private.status
        )
        if candidate.st_ino != private.status.st_ino:
            line = f"{PRIVATE_CANDIDATE} is another file than {PRIVATE_FILE}; fix it yourself"
            return SigningState.OPERATOR_FIX, line
        if public is None:
            return SigningState.PUBLIC_REWRITE, f"{folder / PUBLIC_FILE} does not exist"
        if public.contents != self.openssl_output(DERIVE_PUBLIC_KEY, private.contents):
            line = f"{public.path} is malformed or not the private key's: {REPLACE_COMMAND}"
            return SigningState.BROKEN, line
        if (mode := stat.S_IMODE(public.status.st_mode)) != PUBLIC_KEY_MODE:
            return SigningState.PUBLIC_REWRITE, f"{public.path} has mode {mode:04o}, not 0644"
        return SigningState.SOUND, ""

    def read_entry(self, directory: int, name: str) -> Entry | None:
        path = self.setup.signing_directory / name
        flags = os.O_RDONLY | os.O_NOFOLLOW | os.O_NONBLOCK | os.O_CLOEXEC
        try:
            descriptor = os.open(name, flags, dir_fd=directory)
        except FileNotFoundError:
            return None
        except OSError as error:
            if error.errno == errno.ELOOP:
                return Entry(path, problem="is a symbolic link")
            raise
        try:
            status = os.fstat(descriptor)
            if not stat.S_ISREG(status.st_mode):
                return Entry(path, status, problem="is not a regular file")
            if status.st_uid != self.setup.tools.service_uid:
                return Entry(path, status, problem=self.setup.wrong_owner(path, status.st_uid).line)
            return Entry(path, status, read_within_limit(descriptor))
        finally:
            os.close(descriptor)

    def private_refusal(self, contents: bytes) -> str | None:
        """Why this is not the key the service accepts, else None; says nothing of its bytes."""
        if len(contents) > MAX_TOKEN_FILE_BYTES:
            return f"is larger than {MAX_TOKEN_FILE_BYTES} bytes"
        if not PRIVATE_KEY_BLOCK.match(contents):
            return "is not one unencrypted PKCS#8 PEM block"
        result = self.setup.tools.openssl(["pkey", "-noout", "-text_pub"], contents)
        if result.returncode not in (0, 1):  # 1 is how openssl says "no such key"
            raise CannotTell(f"`openssl pkey` exited {result.returncode}")
        if result.returncode == 1:
            return "is not a readable private key"
        if not PUBLIC_KEY_DETAILS.match(result.stdout):
            return f"is not an RSA-{RSA_BITS} key with exponent 65537"
        return None

    def openssl_output(self, arguments: list[str], stdin: bytes = b"") -> bytes:
        result = self.setup.tools.openssl(arguments, stdin)
        if result.returncode != 0:
            raise CannotTell(f"`openssl {arguments[0]}` exited {result.returncode}")
        return result.stdout

    def ensure(self) -> None:
        """Make the pair when there is none, derive a missing public half, clear leftovers; a pair
        that is unusable is refused and left as it is."""
        with self.open_directory(locked=True) as directory:
            state, line = self.judge(directory)
            if state in UNUSABLE:
                raise StepFailure(line)
            leftovers = [name for name in LEFTOVERS if name in os.listdir(directory)]
            if state is SigningState.EMPTY:
                self.create_private(directory)
            if state is not SigningState.SOUND:
                self.write_public(directory, PUBLIC_CANDIDATE, PRIVATE_FILE)
                self.rename_into_place(directory, PUBLIC_CANDIDATE, PUBLIC_FILE)
            self.unlink_all(directory, LEFTOVERS)
            if leftovers:
                self.setup.tools.say(f"removed leftovers: {', '.join(leftovers)}")
                os.fsync(directory)

    @staticmethod
    def rename_into_place(directory: int, source: str, destination: str) -> None:
        os.replace(source, destination, src_dir_fd=directory, dst_dir_fd=directory)
        os.fsync(directory)

    def create_private(self, directory: int) -> None:
        """Exclusive twice: the candidate is created with O_EXCL, and link(2) refuses any entry."""
        self.write_checked(directory, PRIVATE_CANDIDATE)
        os.link(PRIVATE_CANDIDATE, PRIVATE_FILE, src_dir_fd=directory, dst_dir_fd=directory,
                follow_symlinks=False)  # fmt: skip
        os.unlink(PRIVATE_CANDIDATE, dir_fd=directory)
        os.fsync(directory)
        self.setup.tools.say(
            f"made the key pair in {self.setup.signing_directory}; nothing is shown"
        )

    def write_checked(self, directory: int, name: str) -> Entry:
        """A new private key in `name`, kept only if it passes the same check as an active one."""
        self.setup.write_pending(
            directory, self.openssl_output(GENERATE_PRIVATE_KEY), name, PRIVATE_KEY_MODE
        )
        entry = self.read_entry(directory, name)
        if entry is None or entry.problem or self.private_refusal(entry.contents):
            raise StepFailure("the new key failed its check; the active pair is unchanged")
        return entry

    def write_public(self, directory: int, name: str, source: str) -> None:
        private = self.read_entry(directory, source)
        public = self.openssl_output(DERIVE_PUBLIC_KEY, private.contents)
        self.setup.write_pending(directory, public, name, PUBLIC_KEY_MODE)

    @staticmethod
    def unlink_all(directory: int, names: tuple[str, ...]) -> None:
        for name in names:
            with contextlib.suppress(FileNotFoundError):
                os.unlink(name, dir_fd=directory)

    def replace(self) -> None:
        """Both halves over the old pair (stages R0 to R2 of docs/agent-service.md), after a typed
        yes at a terminal."""
        if not self.setup.tools.has_terminal():
            raise StepFailure("--replace-signing-key needs a terminal; nothing was changed")
        if gap := self.setup.directory_gap(self.setup.signing_directory):
            raise StepFailure(f"{gap.line}; run agent-service/setup first")
        self.setup.tools.say(
            "--replace-signing-key replaces both halves and deletes the old private key; "
            "replacement alone revokes nothing: the old key keeps signing and stays trusted until "
            "agent-service and songmaker-web are both recreated, and tool calls fail with 401 "
            "while only one of them is"
        )
        try:
            answer = self.setup.tools.confirm("type yes to replace the signing key: ")
        except EOFError:
            answer = ""
        if answer.strip() != "yes":
            raise StepFailure("not confirmed; nothing was changed")
        with self.open_directory(locked=True) as directory:
            if (judgement := self.judge(directory))[0] is SigningState.FOREIGN:
                raise StepFailure(judgement[1])
            self.unlink_all(directory, LEFTOVERS)
            self.write_checked(directory, PRIVATE_NEXT)
            self.write_public(directory, PUBLIC_NEXT, PRIVATE_NEXT)
            os.fsync(directory)  # R0 ends here: nothing active has changed
            self.rename_into_place(directory, PRIVATE_NEXT, PRIVATE_FILE)
            self.rename_into_place(directory, PUBLIC_NEXT, PUBLIC_FILE)  # between: R1
        self.setup.tools.say(
            "replaced both halves; nothing is shown. Now recreate agent-service "
            "(`python3 agent-service/live_smoke.py --mcp-signer` while songmaker-web is not on "
            "the network, else as docs/agent-service.md says), then songmaker-web with "
            "songmaker's own deploy command"
        )


def failure_line(what: str, result: subprocess.CompletedProcess[str]) -> str:
    """Docker says why on stderr and may print `[]` on stdout, so stderr is read first."""
    for stream in (result.stderr, result.stdout):
        if lines := [line.strip() for line in stream.splitlines() if line.strip()]:
            line = lines[-1][:MAX_DIAGNOSTIC_CHARACTERS]
            return f"`{what}` exited {result.returncode}: {line}"
    return f"`{what}` exited {result.returncode}: no output"


def main() -> int:
    parser = argparse.ArgumentParser(
        description=__doc__.splitlines()[0],
        epilog="\n".join(__doc__.splitlines()[3:]),
        formatter_class=argparse.RawDescriptionHelpFormatter,
    )
    mode = parser.add_mutually_exclusive_group()
    mode.add_argument("--check", action="store_true", help="change nothing: exit 0, 1 or 2")
    mode.add_argument("--renew", action="store_true", help="always take a new token")
    mode.add_argument(
        "--replace-signing-key", action="store_true", help="make a new signing key pair"
    )
    arguments = parser.parse_args()
    setup = AgentServiceSetup(Tools(), Path.home())
    if arguments.replace_signing_key:
        return setup.replace_signing_key()
    return setup.check() if arguments.check else setup.run(renew=arguments.renew)


if __name__ == "__main__":
    sys.exit(main())
