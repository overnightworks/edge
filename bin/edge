#!/bin/sh
# Runs the command this file is called by (edge, or hal through the symlink bin/hal) of the checkout
# this file lives in, with that checkout's locked dependencies, from any directory and through any symlink.
set -eu

checkout=$(dirname "$(dirname "$(readlink -f "$0")")")

# Another project's activated environment would otherwise make uv sync into, or warn about, it.
unset VIRTUAL_ENV UV_PROJECT_ENVIRONMENT

if ! uv sync --locked --inexact --no-dev --quiet --project "$checkout"; then
    echo "$(basename "$0"): cannot sync the live checkout's dependencies; run \`uv sync --locked\` in $checkout" >&2
    exit 2
fi

# exec, not a child: the command stays the shell's direct child, so Ctrl-C reaches it alone.
exec "$checkout/.venv/bin/$(basename "$0")" "$@"
